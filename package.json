{
  "name": "dsh-dead-links",
  "version": "0.1.1",
  "description": "DSH plugin: Markdown dead-link checker tool (dead_links), zero-dependency.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "links",
    "docs",
    "markdown"
  ],
  "license": "MIT",
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "transactional",
      "adapter": "profile-bundle",
      "failurePolicy": "generation-rollback",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "restart-profile",
      "dispose": "supported"
    },
    "permissions": [
      "filesystem:read",
      "network:outbound"
    ],
    "compatibility": {
      "dshVersions": [
        "0.1.0-rc.6"
      ]
    },
    "capability": {
      "id": "dead-links-tool",
      "kind": "tool",
      "invocation": "call dead_links on a directory containing one markdown file with one live and one dead link",
      "expected": "returns ok=true with filesScanned=1 and dead containing only the .invalid link"
    },
    "evidence": {
      "install": "docs/WORKSHOP.md",
      "failureIsolation": "docs/WORKSHOP.md",
      "hotReload": null,
      "remove": "docs/WORKSHOP.md"
    }
  }
}
